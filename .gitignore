.env
compose.override.yaml
*.log
__pycache__/
*.pyc

# NOTE: data/ is deliberately NOT ignored. Curated and vendored files are the
# spec; machine-owned artefacts are listed individually instead.
data/*.tmp
data/board.json
data/updater-state.json

# Working files that live under src/ but are not part of the page. Kept on
# disk deliberately; .dockerignore stops them reaching the image, this stops
# them reaching a commit.
src/_*
src/fonts/
.playwright-mcp/
